# Blind Spot AI - environment configuration
# Copy this file to `.env` and fill in your own values.
# Do NOT commit a real `.env` file with secrets -- it is already covered by
# .gitignore.

# --- AI provider ------------------------------------------------------------
# Which AI client implementation to use. Only "groq" is implemented today.
AI_PROVIDER=groq

# --- Groq connection ----------------------------------------------------------
# Create a free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Model to use for analysis. Must be a currently supported Groq model --
# see https://console.groq.com/docs/models for the current list.
# openai/gpt-oss-120b is an open-weight model with good structured-JSON
# support and is a good default for this project.
GROQ_MODEL=

# Groq's OpenAI-compatible API base URL. You normally do not need to change this.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Timeouts, in seconds.
GROQ_CONNECT_TIMEOUT_SECONDS=5
GROQ_TIMEOUT_SECONDS=60

# Sampling temperature (lower = more deterministic, better for structured JSON).
GROQ_TEMPERATURE=0.2

# --- Analysis limits ----------------------------------------------------------
# Maximum number of characters of document text sent to the model in a
# single analysis pass. Documents exceeding this return a 413 error instead
# of being silently truncated or crashing.
MAX_ANALYSIS_CONTENT_CHARS=20000

# --- Phase 3: multi-agent debate engine ----------------------------------------
# Maximum number of the six specialist agents (Optimist, Skeptic, Security,
# Financial, Ethics, Legal) allowed to call Groq concurrently. Lower this if
# you hit rate limits on a free-tier Groq account.
DEBATE_MAX_CONCURRENT_AGENTS=6

# --- Phase 4: Retrieval-Augmented Generation (RAG) -----------------------------
# RAG is OFF by default -- /analyze and /debate build their prompts exactly
# as in Phase 2/3 (the full document text) unless this is explicitly enabled.
RAG_ENABLED=false

# Chunking: word-aware, character-based chunk size and overlap.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# How many chunks to retrieve per query by default (can be overridden per
# call to POST /api/documents/{id}/retrieve).
RAG_TOP_K=5

# Embedding provider. "hashing" (the only provider implemented today) is a
# free, fully local, dependency-free, deterministic embedding -- no API key
# and no model download required. See backend/ai/embeddings/hashing.py and
# the README for why this was chosen, and how to add a different provider.
RAG_EMBEDDING_PROVIDER=hashing

# Vector dimensionality used by the hashing embedding provider.
RAG_EMBEDDING_DIMENSION=256

# Where the local vector store persists its per-document index files
# between application restarts. Defaults to backend/data/vector_store.
RAG_VECTOR_STORE_PATH=
